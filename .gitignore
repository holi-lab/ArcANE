# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
.conda/
build/
dist/
.DS_Store

# Local config (never commit keys)
.env
.env.*
!.env.example

# Caches
cache/
.cache/
.pytest_cache/
.ruff_cache/

# Source novels are never redistributed: the drop point stays empty in git so a
# copyrighted text placed here (see README "1. Arc Construction") cannot be
# committed by accident.
data/novels/*
!data/novels/README.md

# Results — bundle the judge outputs (the inputs to paper tables) but not
# raw role-play jsonl files. Historical benchmark responses are not included
# in the Hugging Face training dataset; new responses are generated locally.
results/inference/**/*.jsonl
!results/inference/**/eval_records_*.jsonl
!results/inference/**/traj_records_*.jsonl
# (eval_summary_*.json and traj_summary_*.json are kept by default — they
# don't match the *.jsonl ignore pattern.)

# Staging / backup artefacts from re-runs (kept locally, not shipped).
results/inference/**/*.partial
results/inference/**/*.bak*
results/inference/**/results_pre/

# Arc-construction intermediates — only the user-facing artifacts (final_auto,
# final_validated, probes) ship; chapter splits, raw stream outputs, and
# per-stage caches are regenerated by arc_construction.run_all.
results/arc_extraction/*/chapters/
results/arc_extraction/*/outputs/
results/arc_extraction/*/cache/

# Paper artefacts that are rebuilt by analysis/build_paper_*
paper_results/

# vLLM / training logs
scripts/vllm-logs/
training/logs/
training/checkpoints/
training/**/outputs/
training/**/third_party/

# Model checkpoints (LoRA + full)
models/
*.safetensors
*.bin

# Notebook scratch
.ipynb_checkpoints/

# The repository-root .gitignore has an unanchored "scripts/" rule, which would
# otherwise swallow the training stack's launchers. Keep them in the release.
!training/sft/scripts/
!training/rl/scripts/
